{
  "name": "marcsh",
  "version": "1.0.0",
  "license": "MIT",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "build:cli": "bun run --filter @marcsh/cli build",
    "link:cli": "bun run build:cli && cd packages/cli && bun link",
    "test": "cd packages/cli && bun test --timeout 60000",
    "release:build": "bun scripts/build-release.ts"
  }
}
